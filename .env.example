# Copia este archivo a ~/.config/dariomail/env (o server/.env en local) y rellena los valores.
# Nunca subas secretos reales al repositorio.

PORT=3001
DARIOMAIL_BIND=127.0.0.1

# Origen de tu servidor Stalwart. Las URLs de API, subida y eventos salen de la sesión JMAP.
STALWART_BASE_URL=https://mail.example.com
DARIOMAIL_USER=you@example.com
# Clave de aplicación creada en Stalwart para DARIOMAIL_USER.
STALWART_APP_PASSWORD=

# Secreto para firmar la cookie de sesión. Genera uno con: openssl rand -base64 32
DARIOMAIL_SECRET=

# Hash argon2 de la clave para entrar a la web. Genéralo con el binario:
# printf '%s' 'tu clave' | ./dariomail hash-password
DARIOMAIL_LOGIN_PASSWORD_HASH=

# true detrás de HTTPS. En local por HTTP usa false para que el navegador guarde la cookie.
DARIOMAIL_COOKIE_SECURE=true

# JSON con los remitentes que pueden mostrar imágenes remotas.
DARIOMAIL_TRUSTED_SENDERS_PATH=data/trusted-senders.json

# --- Frontend (Vite, se lee al hacer npm run build) ---
# Texto opcional junto al nombre en la barra superior, por ejemplo tu dominio: inbox.example.com
# Vacío = no se muestra nada.
VITE_DARIOMAIL_LABEL=
