# Copia este archivo a ~/.config/dariomail/env y rellena los valores.
# No pongas secretos reales en el repositorio.

PORT=3001
DARIOMAIL_BIND=127.0.0.1

# Origen de Stalwart. Las URLs de API, subida y eventos salen de la sesión JMAP.
STALWART_BASE_URL=https://mail.dariomsi.com
DARIOMAIL_USER=dario@dariomsi.com
STALWART_APP_PASSWORD=

# Secreto para firmar la cookie de la bandeja. Genera uno con: openssl rand -base64 32
DARIOMAIL_SECRET=

# Hash argon2 de la clave de la web. Genera uno con el binario:
# printf '%s' 'tu clave' | ./dariomail hash-password
DARIOMAIL_LOGIN_PASSWORD_HASH=

# true detrás del túnel HTTPS. En local por HTTP usa false para que el navegador guarde la cookie.
DARIOMAIL_COOKIE_SECURE=true

# Remitentes que pueden mostrar imágenes remotas. JSON en el servidor.
DARIOMAIL_TRUSTED_SENDERS_PATH=data/trusted-senders.json
